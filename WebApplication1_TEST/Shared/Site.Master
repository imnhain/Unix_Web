<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Unix_Web.Shared.SiteMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%--aa--%>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <%--aa--%>
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Kendatire System</asp:ContentPlaceHolder></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Orbitron:wght@700;900&display=swap" rel="stylesheet" />
    
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
    
    <style>
        :root {
            --primary: #00d4ff;
            --primary-dark: #00a8cc;
            --secondary: #6366f1;
            --accent: #f59e0b;
            --bg-dark: #0f172a;
            --bg-darker: #020617;
            --sidebar-bg: #1e293b;
            --text-light: #e2e8f0;
            --text-dim: #94a3b8;
            --hover-bg: rgba(0, 212, 255, 0.1);
            --border-color: rgba(0, 212, 255, 0.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: var(--bg-dark);
            color: var(--text-light);
            overflow-x: hidden;
        }

        /* Animated Background */
        .bg-animation {
            position: fixed;
            inset: 0;
            z-index: -1;
            background: linear-gradient(-45deg, #020617, #0f172a, #1e293b, #334155);
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
        }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .bg-animation::before {
            content: '';
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(0, 212, 255, 0.1) 0%, transparent 70%);
            top: -200px;
            right: -200px;
            border-radius: 50%;
            animation: float 10s ease-in-out infinite;
            filter: blur(60px);
        }

        .bg-animation::after {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
            bottom: -150px;
            left: -150px;
            border-radius: 50%;
            animation: float 12s ease-in-out infinite reverse;
            filter: blur(60px);
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-30px) rotate(5deg); }
        }

        /* Layout */
        .page-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 280px;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            position: fixed;
            left: 0;
            top: 0;
            height: 100vh;
            overflow-y: visible;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1000;
            box-shadow: 4px 0 20px rgba(0, 0, 0, 0.3);
        }

        .menu {
            overflow-y: auto;
            height: calc(100vh - 80px);
            padding: 20px 0;
        }
        
        .menu::-webkit-scrollbar {
            width: 6px;
        }

        .menu::-webkit-scrollbar-track {
            background: var(--bg-darker);
        }

        .menu::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 3px;
        }

        .sidebar.collapsed {
            width: 80px;
        }

        /* Sidebar Header */
        .sidebar-header {
            padding: 25px 20px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 15px;
            background: rgba(0, 212, 255, 0.05);
            position: relative;
            z-index: 1000;
        }

        .logo-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 4px 15px rgba(0, 212, 255, 0.3);
        }

        .logo-icon svg {
            width: 25px;
            height: 25px;
        }

        .logo-text {
            font-family: 'Orbitron', sans-serif;
            font-size: 20px;
            font-weight: 900;
            letter-spacing: 1px;
            background: linear-gradient(135deg, var(--primary) 0%, #fff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            transition: opacity 0.3s;
        }

        .sidebar.collapsed .logo-text {
            opacity: 0;
            width: 0;
            overflow: hidden;
        }

        /* Toggle Button */
        .sidebar-toggle {
            position: absolute;
            right: -20px;
            top: 28px;
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border: 4px solid var(--bg-dark);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1005;
            box-shadow: 0 4px 20px rgba(0, 212, 255, 0.6);
        }

        .sidebar-toggle:hover {
            transform: scale(1.15);
            box-shadow: 0 0 30px rgba(0, 212, 255, 0.8);
            border-color: var(--primary);
        }

        .sidebar-toggle:active {
            transform: scale(1.05);
        }

        .sidebar-toggle svg {
            width: 20px;
            height: 20px;
            stroke: white;
            stroke-width: 3;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
        }

        .sidebar.collapsed .sidebar-toggle svg {
            transform: rotate(180deg);
        }

        .sidebar.collapsed .sidebar-toggle {
            right: -20px;
        }

        @keyframes pulse-ring {
            0% {
                transform: scale(1);
                opacity: 0.6;
            }
            50% {
                transform: scale(1.3);
                opacity: 0.3;
            }
            100% {
                transform: scale(1.6);
                opacity: 0;
            }
        }

        .sidebar-toggle::before {
            content: '';
            position: absolute;
            inset: -2px;
            border-radius: 50%;
            background: var(--primary);
            opacity: 0.3;
            z-index: -1;
            animation: pulse-simple 2s infinite;
        }

        .sidebar-toggle::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            opacity: 0;
            animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) 1s infinite;
        }

        /* Menu */
        .menu-section {
            margin-bottom: 25px;
        }

        .menu-section-title {
            padding: 10px 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-dim);
            transition: opacity 0.3s;
        }

        .sidebar.collapsed .menu-section-title {
            opacity: 0;
            height: 0;
            padding: 0;
            overflow: hidden;
        }

        .menu-item {
            position: relative;
        }

        .menu-link {
            display: flex;
            align-items: center;
            padding: 14px 20px;
            color: var(--text-light);
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .menu-link::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 4px;
            background: var(--primary);
            transform: scaleY(0);
            transition: transform 0.3s ease;
        }

        .menu-link:hover {
            background: var(--hover-bg);
        }

        .menu-link:hover::before,
        .menu-link.active::before {
            transform: scaleY(1);
        }

        .menu-link.active {
            background: var(--hover-bg);
            color: var(--primary);
        }

        .menu-icon {
            width: 24px;
            height: 24px;
            margin-right: 15px;
            flex-shrink: 0;
            transition: all 0.3s ease;
        }

        .menu-link:hover .menu-icon {
            transform: scale(1.1);
            stroke: var(--primary);
        }

        .menu-link.active .menu-icon {
            stroke: var(--primary);
        }

        .menu-text {
            flex: 1;
            font-size: 14px;
            font-weight: 500;
            transition: opacity 0.3s;
        }

        .sidebar.collapsed .menu-text {
            opacity: 0;
            width: 0;
            overflow: hidden;
        }

        .menu-arrow {
            width: 16px;
            height: 16px;
            transition: all 0.3s ease;
        }

        .sidebar.collapsed .menu-arrow {
            opacity: 0;
        }

        .menu-link.open .menu-arrow {
            transform: rotate(180deg);
        }

        /* Submenu */
        .submenu {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            background: rgba(0, 0, 0, 0.2);
        }

        .submenu.open {
            max-height: 500px;
        }

        .submenu-link {
            display: flex;
            align-items: center;
            padding: 12px 20px 12px 60px;
            color: var(--text-dim);
            text-decoration: none;
            font-size: 13px;
            transition: all 0.3s ease;
        }

        .submenu-link:hover {
            color: var(--primary);
            background: var(--hover-bg);
            padding-left: 65px;
        }

        .submenu-link.active {
            color: var(--primary);
            font-weight: 600;
        }

        .sidebar.collapsed .submenu {
            display: none;
        }

        /* Main Content */
        .main-wrapper {
            flex: 1;
            margin-left: 280px;
            transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .sidebar.collapsed + .main-wrapper {
            margin-left: 80px;
        }

        /* Top Bar */
        .topbar {
            height: 70px;
            background: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-color);
            padding: 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-light);
        }

        /* User Info */
        .user-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 16px;
            background: rgba(0, 212, 255, 0.1);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            font-size: 13px;
            transition: all 0.3s ease;
        }

        .info-item:hover {
            background: rgba(0, 212, 255, 0.15);
            border-color: var(--primary);
        }

        .info-item svg {
            width: 18px;
            height: 18px;
            stroke: var(--primary);
        }

        .info-label {
            color: var(--text-dim);
            font-weight: 500;
        }

        .info-value {
            color: var(--text-light);
            font-weight: 600;
        }

        /* Language Switcher */
        .lang-switch {
            display: flex;
            align-items: center;
            background: rgba(0, 212, 255, 0.1);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 4px;
            gap: 4px;
        }

        .lang-btn {
            padding: 4px 10px;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-dim);
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .lang-btn.active {
            background: var(--primary);
            color: var(--bg-dark);
            box-shadow: 0 2px 8px rgba(0, 212, 255, 0.4);
        }

        /* Logout Button */
        .btn-logout {
            padding: 10px 20px;
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
            font-family: 'Poppins', sans-serif;
        }

        .btn-logout:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(239, 68, 68, 0.5);
        }

        .btn-logout svg {
            width: 18px;
            height: 18px;
        }

        /* Content Area */
        .content-wrapper {
            padding: 30px;
            min-height: calc(100vh - 70px);
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.mobile-open {
                transform: translateX(0);
            }

            .main-wrapper {
                margin-left: 0 !important;
            }

            .topbar {
                padding: 0 15px;
            }

            .info-label {
                display: none;
            }

            .page-title {
                font-size: 18px;
            }

            .content-wrapper {
                padding: 20px 15px;
            }
        }

        /* Tooltip */
        .sidebar.collapsed .menu-link {
            position: relative;
        }

        .sidebar.collapsed .menu-link::after {
            content: attr(data-tooltip);
            position: absolute;
            left: 80px;
            top: 50%;
            transform: translateY(-50%);
            background: var(--bg-darker);
            color: var(--text-light);
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 13px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s;
            border: 1px solid var(--border-color);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            z-index: 1000;
        }

        .sidebar.collapsed .menu-link:hover::after {
            opacity: 1;
        }

        /* Animation */
        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes pulse-simple {
            0% { transform: scale(1); opacity: 0.5; }
            100% { transform: scale(1.5); opacity: 0; }
        }

        .menu-item {
            animation: slideInRight 0.3s ease-out;
            animation-fill-mode: both;
        }

        /* Loading Overlay - Tự động */
        #autoLoadingOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(5px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            animation: fadeIn 0.2s ease-in;
        }

        #autoLoadingOverlay.active {
            display: flex !important;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .auto-loading-content {
            background: rgba(30, 41, 59, 0.95);
            border: 2px solid var(--primary);
            border-radius: 16px;
            padding: 30px 40px;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0, 212, 255, 0.3);
            animation: scaleIn 0.3s ease-out;
        }

        @keyframes scaleIn {
            from { transform: scale(0.8); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .auto-loading-spinner {
            width: 60px;
            height: 60px;
            border: 4px solid rgba(0, 212, 255, 0.2);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 20px;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .auto-loading-text {
            color: var(--text-light);
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .auto-loading-subtext {
            color: var(--text-dim);
            font-size: 13px;
            margin-top: 8px;
        }

        .menu-item:nth-child(1) { animation-delay: 0.05s; }
        .menu-item:nth-child(2) { animation-delay: 0.1s; }
        .menu-item:nth-child(3) { animation-delay: 0.15s; }
        .menu-item:nth-child(4) { animation-delay: 0.2s; }
        .menu-item:nth-child(5) { animation-delay: 0.25s; }
        .menu-item:nth-child(6) { animation-delay: 0.3s; }
    </style>
</head>
<body>
    <div class="bg-animation"></div>
    
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>
        <div class="page-wrapper">
            <div class="sidebar" id="sidebar">
                <div class="sidebar-header">
                    <div class="logo-icon">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L2 7L12 12L22 7L12 2Z" fill="#0f172a" stroke="#0f172a" stroke-width="2"/>
                            <path d="M2 17L12 22L22 17" stroke="#0f172a" stroke-width="2"/>
                            <path d="M2 12L12 17L22 12" stroke="#0f172a" stroke-width="2"/>
                        </svg>
                    </div>
                    <div class="logo-text">KENDATIRE</div>
                </div>

                <div class="menu">
                    <div class="menu-section">
                        <div class="menu-section-title">Main</div>
                        <div class="menu-item">
                            <a href="/Shared/Main.aspx" class="menu-link" data-tooltip="Dashboard">
                                <svg class="menu-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor">
                                    <rect x="3" y="3" width="7" height="7" rx="1" stroke-width="2"/>
                                    <rect x="14" y="3" width="7" height="7" rx="1" stroke-width="2"/>
                                    <rect x="3" y="14" width="7" height="7" rx="1" stroke-width="2"/>
                                    <rect x="14" y="14" width="7" height="7" rx="1" stroke-width="2"/>
                                </svg>
                                <span class="menu-text">Dashboard</span>
                            </a>
                        </div>
                    </div>

                    <div class="menu-section">
                        <div class="menu-section-title">System</div>
                        
                        <div class="menu-item">
                            <a class="menu-link" data-tooltip="CPRD" onclick="toggleSubmenu(this)">
                                <svg class="menu-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor">
                                    <rect x="2" y="3" width="20" height="14" rx="2" stroke-width="2"/>
                                    <path d="M8 21H16M12 17V21" stroke-width="2" stroke-linecap="round"/>
                                </svg>
                                <span class="menu-text">CPRD</span>
                                <svg class="menu-arrow" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor">
                                    <path d="M6 9L12 15L18 9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </a>
                            <div class="submenu">
                                <a href="/Source/CPRD/cprdv01.aspx" class="submenu-link">KV2 - PROCESS PARAMETERS (cprdv01)</a>
                                <a href="/Source/CPRD/cprdv02.aspx" class="submenu-link">KV2 - Production Plan (cprdv02)</a>
                                <a href="#" class="submenu-link">KV2 - Tranfer data (cprdv03)</a>
                            </div>
                        </div>

                        <% if (CheckMenuPermission("DOWNLOAD")) { %>
                        <div class="menu-item">
                            <a href="/Source/Download/DownloadData.aspx" class="menu-link" data-tooltip="Download Data">
                                <svg class="menu-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <polyline points="7 10 12 15 17 10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <line x1="12" y1="15" x2="12" y2="3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <span class="menu-text">Download Data</span>
                            </a>
                        </div>
                        <% } %>

                        <% if (Session["UserDepartment"] != null && Session["UserDepartment"].ToString() == "B22") { %>
                        <div class="menu-item">
                            <a class="menu-link" data-tooltip="Permission management" onclick="toggleSubmenu(this)">
                                <svg class="menu-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor">
                                    <path d="M12 15V17M6 21H18C19.1046 21 20 20.1046 20 19V13C20 11.8954 19.1046 11 18 11H6C4.89543 11 4 11.8954 4 13V19C4 20.1046 4.89543 21 6 21Z" stroke-width="2" stroke-linecap="round"/>
                                    <path d="M8 11V7C8 5.93913 8.42143 4.92172 9.17157 4.17157C9.92172 3.42143 10.9391 3 12 3C13.0609 3 14.0783 3.42143 14.8284 4.17157C15.5786 4.92172 16 5.93913 16 7V11" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <span class="menu-text">Quản lý phân quyền</span>
                                <svg class="menu-arrow" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor">
                                    <path d="M6 9L12 15L18 9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </a>
                            <div class="submenu">
                                <a href="/Source/Admin/UserManagement.aspx" class="submenu-link">User management</a>
                            </div>
                        </div>
                        <% } %>

                        <% if (CheckMenuPermission("MONTHLOCK")) { %>
                        <div class="menu-section">
                            <div class="menu-section-title">Admin IT</div>
                            <div class="menu-item">
                                <a href="/Source/PRD/MonthLock.aspx" class="menu-link" data-tooltip="Khoá tháng">
                                    <svg class="menu-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor">
                                        <rect x="5" y="11" width="14" height="10" rx="2" stroke-width="2"/>
                                        <path d="M8 11V7C8 4.79086 9.79086 3 12 3C14.2091 3 16 4.79086 16 7V11" stroke-width="2" stroke-linecap="round"/>
                                        <circle cx="12" cy="16" r="1" fill="currentColor"/>
                                    </svg>
                                    <span class="menu-text">Khoá tháng PRDSYSN</span>
                                </a>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>

                <div class="sidebar-toggle" onclick="toggleSidebar()">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </div>

            <div class="main-wrapper">
                <div class="topbar">
                    <div class="topbar-left">
                        <div class="page-title">
                            <asp:ContentPlaceHolder ID="PageTitle" runat="server">Dashboard</asp:ContentPlaceHolder>
                        </div>
                    </div>

                    <div class="user-info">
                        
                        <div class="lang-switch">
                            <div class="lang-btn active" id="btn-en" onclick="changeLanguage('en')">EN</div>
                            <div class="lang-btn" id="btn-zh" onclick="changeLanguage('zh')">中文</div>
                        </div>

                        <div class="info-item">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2"/>
                            </svg>
                            <span class="info-label">User:</span>
                            <asp:Label ID="lblUsername" runat="server" CssClass="info-value"></asp:Label>
                        </div>

                        <div class="info-item">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                                <path d="M2 12H22M12 2C14.5013 4.73835 15.9228 8.29203 16 12C15.9228 15.708 14.5013 19.2616 12 22C9.49872 19.2616 8.07725 15.708 8 12C8.07725 8.29203 9.49872 4.73835 12 2Z" stroke="currentColor" stroke-width="2"/>
                            </svg>
                            <span class="info-label">IP:</span>
                            <asp:Label ID="lblUserIP" runat="server" CssClass="info-value"></asp:Label>
                        </div>

                        <asp:UpdatePanel ID="upOnlineUsers" runat="server" UpdateMode="Conditional">
                            <ContentTemplate>
                                <asp:Timer ID="tmrOnlineUsers" runat="server" Interval="300000" OnTick="tmrOnlineUsers_Tick"></asp:Timer>
                                <div class="info-item" style="background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.3);">
                                    <div style="width: 10px; height: 10px; background: #10b981; border-radius: 50%; box-shadow: 0 0 8px #10b981; animation: pulse 2s infinite;"></div>
                                    <span class="info-label">Đang online:</span>
                                    <asp:Label ID="lblOnlineUsers" runat="server" CssClass="info-value" style="color: #10b981;">0</asp:Label>
                                </div>
                            </ContentTemplate>
                        </asp:UpdatePanel>

                        <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn-logout" OnClick="btnLogout_Click" OnClientClick="return confirm('Bạn có chắc muốn đăng xuất?');">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span>Đăng xuất</span>
                        </asp:LinkButton>
                    </div>
                </div>

                <div class="content-wrapper">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </div>
        </div>
        <div id="autoLoadingOverlay">
            <div class="auto-loading-content">
                <div class="auto-loading-spinner"></div>
                <div class="auto-loading-text">Processing...</div>
                <div class="auto-loading-subtext">Please wait</div>
            </div>
        </div>
    </form>

    <script>
        // Toggle Sidebar
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const isCollapsed = sidebar.classList.toggle('collapsed');
            localStorage.setItem('sidebarCollapsed', isCollapsed);
        }

        // Khởi tạo trạng thái sidebar khi load trang
        (function () {
            const collapsed = localStorage.getItem('sidebarCollapsed') === 'true';
            if (collapsed) {
                document.getElementById('sidebar').classList.add('collapsed');
            }
        })();

        // Toggle Submenu
        function toggleSubmenu(element) {
            const submenu = element.nextElementSibling;
            const isOpen = submenu.classList.contains('open');

            // Close all submenus
            document.querySelectorAll('.submenu').forEach(sub => {
                sub.classList.remove('open');
            });
            document.querySelectorAll('.menu-link').forEach(link => {
                link.classList.remove('open');
            });

            // Toggle current submenu
            if (!isOpen) {
                submenu.classList.add('open');
                element.classList.add('open');
            }
        }

        // Set active menu item
        function setActiveMenu() {
            const currentPath = window.location.pathname;
            document.querySelectorAll('.menu-link, .submenu-link').forEach(link => {
                if (link.getAttribute('href') === currentPath) {
                    link.classList.add('active');

                    // If it's a submenu item, open its parent
                    if (link.classList.contains('submenu-link')) {
                        const parentSubmenu = link.closest('.submenu');
                        const parentLink = parentSubmenu.previousElementSibling;
                        parentSubmenu.classList.add('open');
                        parentLink.classList.add('open');
                    }
                }
            });
        }

        // Restore sidebar state and set active menu on page load
        window.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('sidebar');
            const collapsed = localStorage.getItem('sidebarCollapsed') === 'true';

            if (collapsed) {
                sidebar.classList.add('collapsed');
            }

            setActiveMenu();
        });

        // Mobile menu toggle
        function toggleMobileMenu() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('mobile-open');
        }

        (function () {
            var overlay = document.getElementById('autoLoadingOverlay');
            var loadingTimer = null;
            // Thêm cờ để theo dõi luồng tải file riêng biệt
            var isDownloadingExcel = false;

            document.addEventListener('click', function (e) {
                var target = e.target;

                while (target && target.tagName !== 'A' && target.tagName !== 'BUTTON') {
                    target = target.parentElement;
                }

                if (target && target.classList.contains('btn-action')) {

                    if (target.hasAttribute('disabled') ||
                        target.classList.contains('aspNetDisabled') ||
                        (target.tagName === 'A' && !target.hasAttribute('href'))) {
                        e.preventDefault();
                        return;
                    }

                    if (target.classList.contains('btn-cancel') ||
                        target.classList.contains('no-loading') ||
                        target.id === 'btnCancel') {
                        return;
                    }

                    clearTimeout(loadingTimer);

                    loadingTimer = setTimeout(function () {
                        overlay.classList.add('active');
                    }, 50);

                    // XỬ LÝ ĐỘC LẬP CHO NÚT TẢI EXCEL
                    if (target.classList.contains('btn-excel')) {
                        isDownloadingExcel = true; // Bật cờ khóa Loading
                        document.cookie = "fileDownload=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";

                        var checkDownloadTimer = window.setInterval(function () {
                            // Quét mảng cookie để tránh dính cache cũ
                            var cookies = document.cookie.split(';');
                            var isDownloaded = false;

                            for (var i = 0; i < cookies.length; i++) {
                                if (cookies[i].trim().indexOf('fileDownload=true') === 0) {
                                    isDownloaded = true;
                                    break;
                                }
                            }

                            if (isDownloaded) {
                                isDownloadingExcel = false; // Tắt cờ khi đã nhận được file
                                hideLoading();
                                window.clearInterval(checkDownloadTimer);
                                document.cookie = "fileDownload=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
                            }
                        }, 500);
                    }
                }
            });

            function hideLoading() {
                clearTimeout(loadingTimer);
                if (overlay) {
                    overlay.classList.remove('active');
                }
            }

            window.addEventListener('load', hideLoading);

            if (typeof Sys !== 'undefined') {
                var prm = Sys.WebForms.PageRequestManager.getInstance();

                prm.add_beginRequest(function (sender, args) {
                    var triggerControl = args.get_postBackElement();

                    if (triggerControl && triggerControl.id.indexOf('tmrOnlineUsers') > -1) {
                        return;
                    }

                    if (overlay) {
                        overlay.classList.add('active');
                    }
                });

                // Tắt Loading khi xử lý xong
                prm.add_endRequest(function (sender, args) {
                    // Ngăn chặn Timer ngầm (như tmrOnlineUsers) tắt Loading của tiến trình tải file
                    if (!isDownloadingExcel) {
                        hideLoading();
                    }
                });
            }

            // Tăng giới hạn Failsafe lên 5 phút (300.000 ms)
            setInterval(function () {
                if (overlay.classList.contains('active')) {
                    var activeTime = overlay.getAttribute('data-active-time') || 0;
                    if (activeTime > 300000) {
                        isDownloadingExcel = false;
                        hideLoading();
                    }
                    overlay.setAttribute('data-active-time', parseInt(activeTime) + 1000);
                } else {
                    overlay.setAttribute('data-active-time', 0);
                }
            }, 1000);
        })();
    </script>
    
    <script src='<%= ResolveClientUrl("~/Scripts/language-pack.js") %>'></script>

    <asp:ContentPlaceHolder ID="ScriptContent" runat="server"></asp:ContentPlaceHolder>
</body>
</html>