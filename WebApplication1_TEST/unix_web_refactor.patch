+using System.Web.UI;
+using Newtonsoft.Json;
+
+namespace Unix_Web.Helpers
+{
+    /// <summary>
+    /// Helper hiển thị loading spinner khi xử lý
+    /// </summary>
+    public static class LoadingHelper
+    {
+        public static void Show(Page page, string message = "Processing...")
+        {
+            string safeMsg = JsonConvert.ToString(message ?? "");
+            string script = $@"
+                if (typeof showLoading === 'function') {{
+                    showLoading({safeMsg});
+                }}
+            ";
+
+            ScriptManager.RegisterStartupScript(
+                page,
+                page.GetType(),
+                "ShowLoading_" + System.Guid.NewGuid(),
+                script,
+                true
+            );
+        }
+
+        public static void Hide(Page page)
+        {
+            string script = @"
+                if (typeof hideLoading === 'function') {
+                    hideLoading();
+                }
+            ";
+
+            ScriptManager.RegisterStartupScript(
+                page,
+                page.GetType(),
+                "HideLoading_" + System.Guid.NewGuid(),
+                script,
+                true
+            );
+        }
+    }
+}
